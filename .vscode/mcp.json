{
  "mcpServers": {
    "lindorm": {
      "command": "/path/to/uv",
      "args": [
        "--directory",
        "/path/to/alibabacloud-lindorm-mcp-server/",
        "run",
        "python",
        "-m",
        "src.lindorm_mcp_server.server",
        "--lindorm_instance_id",
        "ld-xxxxxxxxxxxxxxxxxx",
        "--using_vpc",
        false
      ]
    }
  }
}
